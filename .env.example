# Discord Bot Token
DISCORD_TOKEN=your_bot_token_here

# Channel ID where the bot should operate (optional, leave empty for all channels)
GM_CHANNEL_ID=

# Timezone for scheduling (e.g., America/New_York, Europe/London, UTC)
TIMEZONE=UTC

# Data directory for persistent storage (Railway: use /data)
# Local development: leave as . (current directory)
DATA_DIR=.
